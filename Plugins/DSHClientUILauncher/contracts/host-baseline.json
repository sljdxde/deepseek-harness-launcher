{
  "host": {
    "layoutPackage": "@deepseek-ai/dsh-client-ui-layout",
    "layoutVersion": "0.2.2-rc.5",
    "sidebarPackage": "@deepseek-ai/dsh-client-ui-sidebar",
    "sidebarVersion": "0.2.2-rc.5"
  },
  "slots": [
    {
      "name": "sidebar",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "main",
      "kind": "keyed",
      "scope": "root"
    },
    {
      "name": "rightbar",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "shell.bottom",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "shell.overlay",
      "kind": "list",
      "scope": "root"
    },
    {
      "name": "shell.leading",
      "kind": "single",
      "scope": "root"
    }
  ],
  "rootRenderSlots": [
    "sidebar",
    "main",
    "rightbar",
    "shell.bottom",
    "shell.overlay",
    "shell.leading"
  ],
  "seats": [
    {
      "name": "sidebar.toggle.badge",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "sidebar.brand.mark",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "sidebar.brand.name",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "sidebar.panellist",
      "kind": "list",
      "scope": "root"
    },
    {
      "name": "sidebar.panellist.actions",
      "kind": "list",
      "scope": "root"
    },
    {
      "name": "sidebar.workspaces",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "sidebar.settings",
      "kind": "single",
      "scope": "root"
    },
    {
      "name": "sidebar.footer.action",
      "kind": "list",
      "scope": "root"
    },
    {
      "name": "sidebar.session.action",
      "kind": "hoc",
      "scope": "root"
    }
  ],
  "layoutService": {
    "face": [
      "panelInfo",
      "selectPanel",
      "beginNavigation",
      "toggleSidebar",
      "openRightbar",
      "closeRightbar"
    ],
    "standardProps": [
      "usePanelInfo"
    ]
  },
  "services": {
    "layout": {
      "members": [
        "panelInfo",
        "selectPanel",
        "beginNavigation",
        "toggleSidebar",
        "openRightbar",
        "closeRightbar"
      ],
      "signatures": [
        "readonly panelInfo: HostObservable<PanelInfo>",
        "selectPanel(panelId: MainPanelId | null): void",
        "beginNavigation(): AbortSignal",
        "toggleSidebar(): void",
        "openRightbar(track: boolean, fullscreen: boolean): void",
        "closeRightbar(): void"
      ]
    },
    "panelInfo": {
      "fields": [
        "readonly activePanelId: MainPanelId | null"
      ],
      "observable": {
        "alias": "export type HostObservable<T> = ObservableSnapshot<T>;",
        "methods": [
          "getSnapshot",
          "subscribe"
        ]
      }
    },
    "provideRoot": {
      "hooks": [
        "panelInfo"
      ]
    }
  }
}
