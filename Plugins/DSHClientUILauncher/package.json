{
  "name": "dsh-client-ui-launcher",
  "version": "0.2.0",
  "description": "dsh 新外壳：接管 root 并重新声明 6 个子槽，右栏 / 2-4-6 分屏 / composer 四件 / 插件工作台容器",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "contract:check": "node tools/contract-snapshot.mjs --check",
    "contract:write": "node tools/contract-snapshot.mjs --write"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
