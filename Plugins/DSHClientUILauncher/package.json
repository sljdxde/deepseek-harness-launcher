{
  "name": "@deepseek-ai/dsh-client-ui-layout",
  "version": "0.2.2-rc.4",
  "description": "dsh 新外壳（同名 drop-in：以 @deepseek-ai/dsh-client-ui-layout 的名义替换宿主 layout 实现）",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.4 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.4 <0.3.0",
    "@deepseek-ai/dsh-client-shortcuts": ">=0.2.2-rc.4 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "contract:check": "node tools/contract-snapshot.mjs --check",
    "contract:write": "node tools/contract-snapshot.mjs --write"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
